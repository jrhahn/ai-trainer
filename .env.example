# Copy this file to .env before running `docker compose up -d`.

# Compose-managed Postgres settings.
POSTGRES_DB=aitrainer
POSTGRES_USER=aitrainer
POSTGRES_PASSWORD=change-this-postgres-password

# Backend application settings.
# Anything other than development/test makes the backend refuse to boot without
# SECRETS_ENCRYPTION_KEY below. Keep it at development locally; deployments set
# production (deploy/ansible/templates/app.env.j2).
APP_ENV=development
# Fernet key encrypting user API keys (Gemini, OpenAI), Strava OAuth tokens and
# intervals.icu keys at rest. Empty means those secrets are stored as PLAINTEXT
# — acceptable locally, never in production (#612).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this makes every already-stored token unreadable.
# Was STRAVA_ENCRYPTION_KEY before #613; the old name still works and logs a
# deprecation warning.
SECRETS_ENCRYPTION_KEY=

# One key per secret type (#12), each optional. Empty means that purpose uses
# SECRETS_ENCRYPTION_KEY above, so you can split one type at a time instead of
# rotating everyone's Strava tokens, intervals.icu key, AI keys and TOTP secret
# in a single operation — which is what rotating the shared key means.
#
# Generate each one separately with the command above. Setting one to the same
# value as SECRETS_ENCRYPTION_KEY is refused at boot: it would validate, encrypt
# and decrypt while giving no independence at all.
#
# STRAVA_TOKEN_ENCRYPTION_KEY, not STRAVA_ENCRYPTION_KEY — the latter is the old
# name for the shared key and still works as one.
STRAVA_TOKEN_ENCRYPTION_KEY=
INTERVALS_ENCRYPTION_KEY=
AI_KEY_ENCRYPTION_KEY=
TOTP_ENCRYPTION_KEY=
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
AUTHELIA_AUTH_ENABLED=true
AUTHELIA_REMOTE_USER_HEADER=Remote-User
AUTHELIA_REMOTE_EMAIL_HEADER=Remote-Email
AUTHELIA_REMOTE_NAME_HEADER=Remote-Name
# Shared secret the reverse proxy injects to prove a request transited it.
# The backend trusts Remote-* identity headers only on requests carrying it, and
# leaving this EMPTY disables header authentication rather than falling back to
# network isolation (ai-trainer-ops#34 — the fallback was the hole: a forged
# Remote-Email authenticated as any athlete). Empty is the right value unless a
# forward-auth proxy is actually in front of the backend; password login is
# unaffected either way.
# Generate e.g. with: openssl rand -hex 32
AUTHELIA_PROXY_SHARED_SECRET=
# Frontend URL(s) – added to the backend CORS allowed-origins list.
# Comma-separate every origin the app can be reached from (both domains, with
# and without www, plus the raw server IP for direct-IP access).
FRONTEND_URL=https://trainlikea.pro,https://www.trainlikea.pro,https://train-like-a.pro,https://www.train-like-a.pro,http://204.168.152.128
# Bare domain – used as the Strava OAuth callback base (https:// is prepended automatically)
SERVER_URL=trainlikea.pro
BACKEND_URL=https://trainlikea.pro
ACME_EMAIL=admin@trainlikea.pro

# Traefik dashboard basic auth (htpasswd format, escape every $ as $$).
# The dashboard listens on the server's loopback only (ai-trainer-ops#99):
#   ssh -L 8080:127.0.0.1:8080 root@<host>   then open http://localhost:8080/dashboard/
# Generate with: htpasswd -nB admin | sed 's/\$/\$\$/g'
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$changeme

# Authelia secrets. Required — compose refuses to start without them (#682).
# An EMPTY value is not the same as a missing one here: it used to fall through
# to a placeholder committed to this public repo, which deployed a published
# secret and came up looking healthy. The reset-password secret signs password
# reset tokens on a publicly routed portal, so a known value means anyone can
# set any user's password and then log in to the app with it.
# Generate each separately with: openssl rand -hex 32
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=replace-with-a-long-random-secret
AUTHELIA_SESSION_SECRET=replace-with-a-long-random-secret
AUTHELIA_STORAGE_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Production Authelia notifications for password reset and identity verification.
# Use with: docker compose -f compose.yml -f compose.smtp.yml up -d
AUTHELIA_NOTIFIER_SMTP_ADDRESS=submission://smtp.example.com:587
AUTHELIA_NOTIFIER_SMTP_USERNAME=smtp-user
AUTHELIA_NOTIFIER_SMTP_PASSWORD=replace-with-smtp-password
AUTHELIA_NOTIFIER_SMTP_SENDER=Train Like a Pro <no-reply@trainlikea.pro>
AUTHELIA_NOTIFIER_SMTP_IDENTIFIER=trainlikea.pro
AUTHELIA_NOTIFIER_SMTP_STARTUP_CHECK_ADDRESS=admin@trainlikea.pro

# Frontend build-time API URL (baked into the static bundle at build time).
# Leave empty in production: the app then calls /api/v1 on whichever domain
# served it, so every domain works (ai-trainer-ops#45). Unset means
# http://localhost:8000 for local development.
VITE_BACKEND_URL=

# Authelia portal URL (baked into the static bundle). Used for logout links.
VITE_AUTHELIA_URL=https://auth.trainlikea.pro

# Optional for app startup, required for corresponding features.
STRAVA_CLIENT_ID=
# Offer connecting Strava directly; production keeps it off (Strava bars AI use of its data).
STRAVA_ENABLED=true
STRAVA_CLIENT_SECRET=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional – set to increase Semantic Scholar API rate limit during ingestion

# --- Models and behaviour (ai-trainer-ops#256) -----------------------------
# All optional; compose.yml carries the defaults shown, which are the
# backend's own. A deployment sets each through the repository variable of
# the same name (deploy/forwarded-vars.yml).
#
# The model for each task, per provider. Gemini runs Flash-Lite on every task
# (#511); raise one task to gemini-3.5-flash if its answers suffer, the coach
# first.
GEMINI_CLASSIFY_MODEL=gemini-3.5-flash-lite
GEMINI_PLAN_MODEL=gemini-3.5-flash-lite
GEMINI_COACH_MODEL=gemini-3.5-flash-lite
GEMINI_FEEDBACK_MODEL=gemini-3.5-flash-lite
OPENAI_CLASSIFY_MODEL=gpt-4o-mini
OPENAI_PLAN_MODEL=gpt-4o-mini
OPENAI_COACH_MODEL=gpt-4o
OPENAI_FEEDBACK_MODEL=gpt-4o
# The embeddings of the cycling-science library. The library and the question
# must come from the same model, so a change means running
# scripts/ingest_cycling_science.py again (#515).
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Whole prompts and answers in the log, for a debugging session only: prompts
# carry the athlete's health data.
LOG_LLM_PAYLOADS=false
# How the coach's observations are matched to readiness advice: llm, or
# keyword, which makes no AI call.
READINESS_OBSERVATION_MATCHING=llm
# Learn about the athlete after every imported workout (#388); false leaves it
# to the weekly jobs.
CONTINUOUS_LEARNING_ENABLED=true
# How often the connected accounts are synced, in seconds (60 at the least).
ACTIVITY_SYNC_INTERVAL_SECONDS=1800
# The zone that decides which day is today for plans and the nightly jobs.
APP_TIMEZONE=Europe/Berlin

# --- Abuse and spend controls (#676 / #682) -------------------------------
# All optional; compose.yml carries the defaults shown. Worth a deliberate
# value on any deployment where registration is reachable from the internet.
#
# With the fallback on, every account that signs up spends the key above.
# Set to false to require each user to bring their own (BYOK-only).
ALLOW_ADMIN_AI_KEY_FALLBACK=true

# AI_STUB_PROVIDER (ai-trainer-ops#46), which answers every AI call from a
# stub, cannot be set here: compose.yml deliberately does not pass it on, so no
# deployment can switch canned coaching on from its .env. The end-to-end stacks
# set it themselves (frontend/e2e/stack.ts).
# Provider tokens one user may spend per window. 0 disables the ceiling; a
# coach message is ~16k tokens, so 5000000 is roughly 300 of them a month.
AI_TOKEN_BUDGET=0
AI_TOKEN_BUDGET_WINDOW_DAYS=30
# Per-user rate limit on the endpoints that spend provider tokens. Two sliding
# windows: the burst stops hammering, the sustained one stops a slow drip.
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_BURST=10
AI_RATE_LIMIT_BURST_SECONDS=60
AI_RATE_LIMIT_SUSTAINED=100
AI_RATE_LIMIT_SUSTAINED_SECONDS=3600
# Tokens the operator's key may spend per rolling 24 hours, over every account
# it pays for. 0 disables it. Above it, every account without a key of its own
# is asked for one until the day's usage ages out.
AI_GLOBAL_DAILY_TOKEN_BUDGET=0
# A private ntfy topic URL (ai-trainer-ops#124): the server pushes a note there
# when the daily budget above is used up. Empty sends nothing.
NTFY_URL=
# Brute-force limits on the auth routes. /admin/login is the tightest: it is
# publicly routed and one password guards every user's email address.
AUTH_RATE_LIMIT_ENABLED=true
ADMIN_LOGIN_RATE_LIMIT_ATTEMPTS=5
ADMIN_LOGIN_RATE_LIMIT_SECONDS=900
REGISTRATION_RATE_LIMIT_ATTEMPTS=20
REGISTRATION_RATE_LIMIT_SECONDS=3600
# Sign-in attempts per email, and across all emails (a password sprayed over
# many addresses). Every attempt counts, not only failures.
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_SECONDS=300
LOGIN_RATE_LIMIT_GLOBAL_ATTEMPTS=60
LOGIN_RATE_LIMIT_GLOBAL_SECONDS=60
# Self-hosted proof-of-work on registration; its key derives from JWT_SECRET.
CAPTCHA_ENABLED=true
CAPTCHA_MAX_NUMBER=20000
CAPTCHA_TTL_SECONDS=600
# Second factor for athletes: the name in the authenticator app, and how long
# a device that opted in may skip it.
TOTP_ISSUER=Train Like A Pro
TRUSTED_DEVICE_DAYS=30
# Sign-up by single-use invitation only (ops#108, #96); codes on the admin page.
SIGNUP_INVITE_ONLY=false
# Named on the privacy page and in the app (ai-trainer-ops#2, #15).
OPERATOR_NAME=
# The postal address on /impressum (ai-trainer-ops#1): one line, comma-separated.
OPERATOR_ADDRESS=
CONTACT_EMAIL=
# Refuse a registration that does not agree to the privacy policy (the form
# always asks; this makes the server insist too). Deployments set true.
REQUIRE_PRIVACY_CONSENT=false
# Let athletes consent to the weekly coach review reading their week
# (ai-trainer-ops#136). Off until a processing agreement covers it.
COACH_REVIEW_OPT_IN=false

# Password reset by email (ai-trainer-ops#35). The app sends the mail itself,
# through a transactional provider; empty SMTP_HOST leaves the reset off.
# Scaleway TEM: host smtp.tem.scaleway.com, user = project ID, password = the
# secret key of an IAM API key limited to Transactional Email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Train Like a Pro <noreply@trainlikea.pro>
# A new account confirms its address before it signs in (app #687). Applies
# only where SMTP_HOST is set: without mail nobody could confirm.
EMAIL_VERIFICATION_REQUIRED=true

# The /admin panel. An empty password disables it. The TOTP secret adds a
# second factor; generate it with: cd backend && uv run python -m scripts.generate_admin_totp
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=

# Request size limits (#682): any request body, one .fit file, and the files in
# one bulk upload (each costs an AI call).
MAX_REQUEST_BODY_BYTES=67108864
FIT_UPLOAD_MAX_BYTES=10485760
FIT_UPLOAD_BULK_MAX_FILES=25

# Optional – Grafana admin password (#549). Grafana binds to 127.0.0.1 and
# carries no Traefik route, so it is reachable only through an SSH tunnel:
#   ssh -L 3000:127.0.0.1:3000 root@<host>   then open http://localhost:3000
# Left empty, compose falls back to "admin", which Grafana asks you to change
# on first login.
GRAFANA_ADMIN_PASSWORD=
