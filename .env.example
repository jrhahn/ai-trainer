# Copy this file to .env before running `docker compose up -d`.

# Compose-managed Postgres settings.
POSTGRES_DB=aitrainer
POSTGRES_USER=aitrainer
POSTGRES_PASSWORD=change-this-postgres-password

# Backend application settings.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
AUTHELIA_AUTH_ENABLED=true
AUTHELIA_REMOTE_USER_HEADER=Remote-User
AUTHELIA_REMOTE_EMAIL_HEADER=Remote-Email
AUTHELIA_REMOTE_NAME_HEADER=Remote-Name
# Frontend URL(s) – added to the backend CORS allowed-origins list.
# Comma-separate every origin the app can be reached from (both domains, with
# and without www, plus the raw server IP for direct-IP access).
FRONTEND_URL=https://trainlikea.pro,https://www.trainlikea.pro,https://train-like-a.pro,https://www.train-like-a.pro,http://204.168.152.128
BACKEND_URL=https://trainlikea.pro
ACME_EMAIL=admin@trainlikea.pro

# Traefik dashboard basic auth (htpasswd format, escape every $ as $$).
# Generate with: htpasswd -nB admin | sed 's/\$/\$\$/g'
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$changeme

# Authelia secrets (set long random values).
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=replace-with-a-long-random-secret
AUTHELIA_SESSION_SECRET=replace-with-a-long-random-secret
AUTHELIA_STORAGE_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Frontend build-time API URL (baked into the static bundle at build time).
VITE_BACKEND_URL=https://trainlikea.pro

# Authelia portal URL (baked into the static bundle). When set, the frontend
# delegates login/register/logout to Authelia instead of using local forms.
VITE_AUTHELIA_URL=https://auth.trainlikea.pro

# Optional for app startup, required for corresponding features.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
OPENAI_API_KEY=
GEMINI_API_KEY=
