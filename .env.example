# Copy this file to .env before running `docker compose up -d`.

# Compose-managed Postgres settings.
POSTGRES_DB=aitrainer
POSTGRES_USER=aitrainer
POSTGRES_PASSWORD=change-this-postgres-password

# Backend application settings.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Frontend build-time API URL.
VITE_BACKEND_URL=http://localhost:8000

# Optional for app startup, required for corresponding features.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
OPENAI_API_KEY=
GEMINI_API_KEY=