# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Frontend build artifacts & dependencies
frontend/node_modules
# An npx or vitest run from the repository root leaves its cache here.
/node_modules/
frontend/dist
frontend/dist-ssr
frontend/coverage
frontend/.env*

# Local env files (apply globally)
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.codex
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Env files
.env
.env.*
!.env.example

# Python
**/__pycache__/
**/*.pyc
.pytest_cache/

# Python backend
backend/.venv
# Every local SQLite database: the dev default app.db (alembic/env.py) and the
# test runs' files (ai-trainer-ops#290).
backend/*.db
backend/.coverage
backend/coverage.xml
backend/htmlcov/
backend/*.egg-info/

# Docker
docker-compose.override.yml

# Deploy / Ansible
deploy/ansible/*.retry

# Graphify knowledge graph — regenerable artifact, rebuilt locally by the
# post-commit/post-checkout git hooks (graphify hook install). Not tracked to
# avoid stale committed copies and large graph.json diffs on every code PR.
graphify-out/
