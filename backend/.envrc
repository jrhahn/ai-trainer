# direnv configuration for the AI Trainer backend.
#
# direnv will automatically run this file when you cd into the backend/
# directory (if direnv is installed and hooked into your shell).
#
# What it does:
#   1. Creates the virtual environment in .venv via `uv sync` (if not present)
#   2. Activates .venv so that `python`, `uvicorn`, etc. resolve from there
#
# Installation: https://direnv.net/docs/installation.html
# Then run: direnv allow

export VIRTUAL_ENV="$(pwd)/.venv"

if [ ! -d "$VIRTUAL_ENV" ]; then
    log_status "No .venv found — running uv sync to create it..."
    uv sync
fi

PATH_add "$VIRTUAL_ENV/bin"
