# Required – your registered Strava application credentials
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret

# Required – server-side AI credentials
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key

# Optional – override models per task type (defaults shown)
# Cheap tasks (classification, plan generation):
#   OPENAI_CLASSIFY_MODEL=gpt-4o-mini
#   OPENAI_PLAN_MODEL=gpt-4o-mini
#   GEMINI_CLASSIFY_MODEL=gemini-2.5-flash
#   GEMINI_PLAN_MODEL=gemini-2.5-flash
# Strong tasks (conversational coaching, post-ride feedback):
#   OPENAI_COACH_MODEL=gpt-4o
#   OPENAI_FEEDBACK_MODEL=gpt-4o
#   GEMINI_COACH_MODEL=gemini-2.5-flash
#   GEMINI_FEEDBACK_MODEL=gemini-2.5-flash

# Required – auth and persistence
DATABASE_URL=postgresql+asyncpg://user:password@localhost/aitrainer
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Runtime environment – set to "production" or "staging" outside local dev.
# The app refuses to start if JWT_SECRET is the default value and APP_ENV is
# not one of: development, dev, local, test, testing.
APP_ENV=development

# Where the React frontend is served (used for CORS + redirect back)
FRONTEND_URL=http://localhost:5173

# Public domain of this server (used as the OAuth callback base URL sent to Strava).
# Production: bare domain, e.g. trainlikea.pro  (https:// is added automatically)
# Local dev:  leave blank and set BACKEND_URL instead
SERVER_URL=

# Fallback for local development when SERVER_URL is not set
BACKEND_URL=http://localhost:8000
