# Required – your registered Strava application credentials
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret

# Required – server-side AI credentials
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key

# Optional – override models per task type (defaults shown)
# OpenAI – cheap tasks (classification, plan generation):
#   OPENAI_CLASSIFY_MODEL=gpt-4o-mini
#   OPENAI_PLAN_MODEL=gpt-4o-mini
# OpenAI – strong tasks (conversational coaching, post-ride feedback):
#   OPENAI_COACH_MODEL=gpt-4o
#   OPENAI_FEEDBACK_MODEL=gpt-4o
# Gemini runs Flash-Lite on every task (#511) — 5x cheaper input, 3.6x cheaper
# output than Flash. Each task is independently overridable, so a single one can
# be raised back to gemini-3.5-flash without touching the others:
#   GEMINI_CLASSIFY_MODEL=gemini-3.5-flash-lite
#   GEMINI_PLAN_MODEL=gemini-3.5-flash-lite
#   GEMINI_COACH_MODEL=gemini-3.5-flash-lite
#   GEMINI_FEEDBACK_MODEL=gemini-3.5-flash-lite

# Optional – how the coach's personal observations of the athlete are matched
# to readiness recommendations: "llm" (nuanced, default) or "keyword" (no LLM call).
#   READINESS_OBSERVATION_MATCHING=llm

# Required – auth and persistence
DATABASE_URL=postgresql+asyncpg://user:password@localhost/aitrainer
JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Runtime environment – set to "production" or "staging" outside local dev.
# The app refuses to start outside dev/test if JWT_SECRET is the default value
# or shorter than 32 bytes for HS256.
APP_ENV=development

# Athlete-facing calendar timezone used for "today", "tomorrow", and "yesterday"
# in coach prompts and date-sensitive training calculations.
APP_TIMEZONE=Europe/Berlin

# Where the React frontend is served (used for CORS + redirect back)
FRONTEND_URL=http://localhost:5173

# Public domain of this server (used as the OAuth callback base URL sent to Strava).
# Production: bare domain, e.g. trainlikea.pro  (https:// is added automatically)
# Local dev:  leave blank and set BACKEND_URL instead
SERVER_URL=

# Fallback for local development when SERVER_URL is not set
BACKEND_URL=http://localhost:8000
