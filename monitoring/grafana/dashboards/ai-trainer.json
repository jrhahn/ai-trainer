{
  "uid": "ai-trainer-overview",
  "title": "AI Trainer \u2014 cost and health",
  "tags": [
    "ai-trainer"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "LLM cost",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Estimated spend, last 24h",
      "description": "Prices are hard-coded for gemini-3.5-flash-lite ($0.30/M input, $2.50/M output) and are wrong the moment the coach model changes \u2014 see GEMINI_COACH_MODEL. Cached input would bill at a tenth, but flash-lite serves no cache (#538), so it is not subtracted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 3
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(llm_tokens_total{kind=\"input\"}[24h])) * 0.30 / 1e6 + sum(increase(llm_tokens_total{kind=\"output\"}[24h])) * 2.50 / 1e6"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tokens per hour by source",
      "description": "Which feature is spending. The prefix says what opened the scope: 'api:' an endpoint, 'job:' a scheduler job, 'bg:' a background task after a response, 'step:' a reusable step that runs under any of those \u2014 so a 'step:' cost can belong to either a request or a job.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 18,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source) (increase(llm_tokens_total{kind=~\"input|output\"}[1h]))",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Calls per hour by task",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task) (increase(llm_calls_total[1h]))",
          "legendFormat": "{{task}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failed calls per hour by model",
      "description": "A model that starts rejecting every request is free in token terms and invisible without this \u2014 that is what #401 looked like.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (increase(llm_calls_total{ok=\"false\"}[1h]))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Mean provider latency by task",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task) (rate(llm_latency_seconds_total[30m])) / clamp_min(sum by (task) (rate(llm_calls_total[30m])), 0.0001)",
          "legendFormat": "{{task}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Coach replies by contract per hour",
      "description": "A 'prose' reply still reached the athlete, but carried no planUpdates \u2014 the coach could not change the plan on that turn. Prose was a 500 before #558. A steady share is the argument for moving the coach off Flash-Lite (#511).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (contract) (increase(coach_replies_total[1h]))",
          "legendFormat": "{{contract}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "App health",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 19
      }
    },
    {
      "type": "timeseries",
      "title": "Requests per second by route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_requests_total[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Server errors per second by route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request latency p95 by route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Scheduler job duration p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, scheduler_job) (rate(scheduler_job_duration_seconds_bucket[6h])))",
          "legendFormat": "{{scheduler_job}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Scheduler outcomes per hour",
      "description": "'skipped' means the previous run was still going \u2014 a few are normal, a steady stream means the job no longer fits its interval.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (scheduler_job, status) (increase(scheduler_job_runs_total[1h]))",
          "legendFormat": "{{scheduler_job}} {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Database connection pool",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "db_connection_pool",
          "legendFormat": "{{state}}"
        }
      ]
    }
  ]
}
