POSTGRES_DB={{ postgres_db | default('aitrainer') }}
POSTGRES_USER={{ postgres_user | default('aitrainer') }}
POSTGRES_PASSWORD={{ postgres_password }}

JWT_SECRET={{ jwt_secret }}
JWT_ALGORITHM={{ jwt_algorithm | default('HS256') }}
JWT_EXPIRE_MINUTES={{ jwt_expire_minutes | default('10080') }}
AUTHELIA_AUTH_ENABLED={{ authelia_auth_enabled | default('true') }}
AUTHELIA_REMOTE_USER_HEADER={{ authelia_remote_user_header | default('Remote-User') }}
AUTHELIA_REMOTE_EMAIL_HEADER={{ authelia_remote_email_header | default('Remote-Email') }}
AUTHELIA_REMOTE_NAME_HEADER={{ authelia_remote_name_header | default('Remote-Name') }}
AUTHELIA_PROXY_SHARED_SECRET={{ authelia_proxy_shared_secret | default('') }}
{# These three were `| default('')`, which rendered an empty line — and an
   empty value makes compose's `${VAR:-...}` fall through to its default, so
   production ran on the placeholder committed to this public repository. The
   reset-password secret is the sharp one: auth.<domain> is publicly routed and
   a forgeable reset token sets any user's password, which logs in to the app.
   Undefined here rather than empty, so a deploy that forgot them stops instead
   of shipping a published secret (#682). Same reasoning as
   SECRETS_ENCRYPTION_KEY below. Generate each with `openssl rand -hex 32`.

   Rotating AUTHELIA_STORAGE_ENCRYPTION_KEY on a live instance needs
   `authelia storage encryption change-key`; with no 2FA enrolled there is
   nothing in /data/db.sqlite3 worth keeping, so removing the volume is the
   simpler path. #}
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET={{ authelia_identity_validation_reset_password_jwt_secret | default(undef('authelia_identity_validation_reset_password_jwt_secret was not passed to the playbook. Generate with: openssl rand -hex 32')) }}
AUTHELIA_SESSION_SECRET={{ authelia_session_secret | default(undef('authelia_session_secret was not passed to the playbook. Generate with: openssl rand -hex 32')) }}
AUTHELIA_STORAGE_ENCRYPTION_KEY={{ authelia_storage_encryption_key | default(undef('authelia_storage_encryption_key was not passed to the playbook. Generate with: openssl rand -hex 32')) }}
AUTHELIA_NOTIFIER_SMTP_ADDRESS={{ authelia_notifier_smtp_address | default('') }}
AUTHELIA_NOTIFIER_SMTP_USERNAME={{ authelia_notifier_smtp_username | default('') }}
AUTHELIA_NOTIFIER_SMTP_PASSWORD={{ authelia_notifier_smtp_password | default('') }}
AUTHELIA_NOTIFIER_SMTP_SENDER={{ authelia_notifier_smtp_sender | default('') }}
AUTHELIA_NOTIFIER_SMTP_IDENTIFIER={{ authelia_notifier_smtp_identifier | default(server_url) }}
AUTHELIA_NOTIFIER_SMTP_STARTUP_CHECK_ADDRESS={{ authelia_notifier_smtp_startup_check_address | default(acme_email | default('admin@' ~ server_url)) }}

{# FRONTEND_URL is the CORS allowlist, and the app sends credentials, so a
   plain-http origin in here is a credentialed cross-origin channel over
   cleartext. The trailing 'http://<server_ip>' entry is gone (#682): every
   Traefik router matches on Host(), so a request to the bare IP never matched
   a route in the first place and the origin could not have been serving the
   app. #}
FRONTEND_URL={{ frontend_url | default('https://' ~ server_url ~ ',https://www.' ~ server_url ~ ',https://' ~ server_url_2 ~ ',https://www.' ~ server_url_2) }}
SERVER_URL={{ server_url }}
BACKEND_URL={{ backend_url | default('https://' ~ server_url) }}
VITE_BACKEND_URL={{ vite_backend_url | default('https://' ~ server_url) }}
VITE_AUTHELIA_URL={{ vite_authelia_url | default('https://auth.' ~ server_url) }}
ACME_EMAIL={{ acme_email | default('admin@' ~ server_url) }}

TRAEFIK_DASHBOARD_AUTH={{ admin_pass_hash }}

ADMIN_PASSWORD={{ admin_password | default('') }}

{# AI spend controls (#676), stated here because this template — not
   compose.yml — is what production actually renders. None of these had a line
   here, so prod silently took the compose defaults: the token budget was 0,
   i.e. off, while registration is public (its own Traefik router) and the
   admin-key fallback is on. That combination means every account that signs up
   spends the owner's provider key with no ceiling. Same class of problem as
   #617: a variable missing from this file is invisible, not defaulted-as-
   intended.

   ALLOW_ADMIN_AI_KEY_FALLBACK stays true so a running instance keeps working
   for its existing users; set allow_admin_ai_key_fallback: false in the vars
   to require every account to bring its own key (BYOK-only). The budget below
   is the ceiling that applies either way — ~300 coach messages per user per
   30 days at ~16k tokens each (#510/#556). #}
ALLOW_ADMIN_AI_KEY_FALLBACK={{ allow_admin_ai_key_fallback | default('true') }}
AI_RATE_LIMIT_ENABLED={{ ai_rate_limit_enabled | default('true') }}
{# 5000000 was the first value here and it was below the operator's own normal
   usage — ~6.3M tokens per rolling 30 days, measured from llm_calls after it
   locked them out of their own coach (#684). The budget exists to stop a
   stranger draining the owner's provider key, not to ration the owner, so it
   is set several times over observed peak: monthly totals run 4.7-5.0M, the
   rolling window peaks around 6.3M. Override with the AI_TOKEN_BUDGET
   repository variable rather than editing this default. #}
AI_TOKEN_BUDGET={{ ai_token_budget | default('25000000') }}
AI_TOKEN_BUDGET_WINDOW_DAYS={{ ai_token_budget_window_days | default('30') }}

{# Auth brute-force controls (#682). Every auth route was previously reachable
   at unlimited rate, including /admin/login, which is publicly routed and
   guards the full user list plus user deletion. #}
AUTH_RATE_LIMIT_ENABLED={{ auth_rate_limit_enabled | default('true') }}
ADMIN_LOGIN_RATE_LIMIT_ATTEMPTS={{ admin_login_rate_limit_attempts | default('5') }}
ADMIN_LOGIN_RATE_LIMIT_SECONDS={{ admin_login_rate_limit_seconds | default('900') }}
REGISTRATION_RATE_LIMIT_ATTEMPTS={{ registration_rate_limit_attempts | default('5') }}
REGISTRATION_RATE_LIMIT_SECONDS={{ registration_rate_limit_seconds | default('3600') }}

{# Registration captcha (#686). Nine bot signups over two months found the
   public /register router; the rate limit bounds their rate but cannot tell
   them from a human. Proof-of-work is self-hosted, so unlike Turnstile it
   needs no CSP hole and no third party sees the visitors. No secret here on
   purpose — the signing key derives from JWT_SECRET. #}
CAPTCHA_ENABLED={{ captcha_enabled | default('true') }}
CAPTCHA_MAX_NUMBER={{ captcha_max_number | default('20000') }}

{# Deliberately no default: a deployment without an encryption key would store
   user API keys and OAuth tokens as plaintext, and before #612 that happened
   silently. Failing here aborts the deploy and leaves the running containers
   untouched, which is the safest way to notice a missing secret. Generate one
   with:
     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
   Rotating it makes every stored token unreadable — see the advisory.

   `strava_encryption_key` is the pre-#613 variable name and is accepted so a
   vault that already carries it keeps working. Rename it in your vars when
   convenient; the backend logs a deprecation warning until you do.

   The chain ends in `undef()` rather than in the bare legacy name: Jinja reports
   the *tail* of a `default()` chain when nothing in it is defined, so a deploy
   that never passed the key failed with "'strava_encryption_key' is undefined"
   and sent whoever read it looking for a variable they had never set (#617). #}
{# Build-time uid/gid for the non-root backend container (#682). Must match the
   owner of ./authelia on the host, because registration writes
   users_database.yml through that bind mount and a mount keeps host ownership.
   Ansible builds the images on the server, so this .env is what reaches the
   build. Check with `ls -lan authelia/` before changing it. #}
APP_UID={{ app_uid | default('1000') }}
APP_GID={{ app_gid | default('1000') }}

APP_ENV={{ app_env | default('production') }}
SECRETS_ENCRYPTION_KEY={{ secrets_encryption_key | default(strava_encryption_key | default(undef('SECRETS_ENCRYPTION_KEY was not passed to the playbook. It is a GitHub environment secret; the deploy workflow forwards it as the secrets_encryption_key extra-var.'))) }}

STRAVA_CLIENT_ID={{ strava_client_id | default('') }}
STRAVA_CLIENT_SECRET={{ strava_client_secret | default('') }}
OPENAI_API_KEY={{ openai_api_key | default('') }}
GEMINI_API_KEY={{ gemini_api_key | default('') }}

{# Grafana is bound to 127.0.0.1 with no Traefik route, so it is only reachable
   through an SSH tunnel. Empty here leaves compose's default ("admin"), which
   Grafana makes you change on first login (#549). #}
GRAFANA_ADMIN_PASSWORD={{ grafana_admin_password | default('') }}
